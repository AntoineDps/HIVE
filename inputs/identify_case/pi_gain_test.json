    "n_B": 3,
    "n_K": 2,
    "B_init": 150000,
    "K_init": 0,
    "stability": {
      "enabled": true,
      "r": 5.0
    },
    "objective": {
      "name": "mean_P_abs",
      "direction": "maximize"
    }
  },
  "solver": {
    "method": "RK4",
    "dt": 0.05,
    "interpolation": {"fe": true, "eta_hs": true}
  }
