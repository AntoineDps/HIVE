{
  "scheme": "pi_gain",
  "waves_train": [
    {"type": "cfd_case", "case_name": "cases_test"}
  ],
  "base_model": "linear",
  "scheme_params": {
    "method": ["analytical", "opt", "grid"],
    "B_min": 0,
    "B_max": 500000,
    "K_min": -200000,
