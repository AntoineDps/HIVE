{
  "scheme": "pi_gain",
  "waves_train": [
    {"type": "cfd_case", "case_name": "cases"}
  ],
  "base_model": "nlinearHs_sphere_r5",
  "scheme_params": {
    "method": ["opt", "grid"],
    "B_min": 0,
    "B_max": 400000,
    "K_min": -700000,
    "K_max": 0,
    "n_B": 10,
    "n_K": 20,
    "B_init": 150000,
    "K_init": 100000,
    "stability": {
      "enabled": true,
      "r": 5.0
    },
    "objective": {
      "name": "mean_P_abs",
      "direction": "maximize"
    }
  },
  "solver": {
    "method": "RK4",
    "dt": 0.05,
    "interpolation": {"fe": true, "eta_hs": true}
  },
  "plot_options": {
    "timeseries":             true,
    "relative_position_dist": true,
    "gains_grid":             true,
    "gains_scatter":          true
  }
}