{
  "scheme": "viscous_drag",
  "waves_train": [
    "cases_small"
  ],
  "base_model": "linear_sphere_r5",
  "scheme_params": {
    "base_force": "fhyd_lin",
    "type": [
      "response"
    ],
    "search": [
      "opt",
      "grid"
    ],
    "c_v_min": 0,
    "c_v_max": 150000,
    "n_points": 5,
    "objective": "rmse_x"
  },
  "solver": {
    "method": "RK4",
    "dt": 0.05,
    "interpolation": {
      "fe": true,
      "eta_hs": true
    }
  },
  "plot_options": {
    "cost_curves": true,
    "coeff_grid": true,
    "coeff_distribution": true,
    "metric_distribution": true,
    "timeseries": true,
    "metric_grid":   {"metrics": ["nrmse_range_x", "nrmse_range_P_abs"]},
    "metric_stat":   {"metrics": ["nrmse_range_x", "nrmse_range_P_abs"]},
    "metric_scalar": {"metrics": ["nrmse_range_x", "nrmse_range_P_abs"]}
  }
}